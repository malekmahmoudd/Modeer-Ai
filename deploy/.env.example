DOMAIN=your-domain.example
# URL-safe random hex only (used inside DATABASE_URL).
DB_PASSWORD=replace-with-64-random-hex-characters
AUTH_SECRET=replace-with-at-least-32-random-characters
# User UUID -> SHA-256 access-key digest. Provision accounts before opening access.
AUTH_ACCESS_KEYS={}
LLM_PROVIDER=groq
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=35
MEMORY_TIMEOUT_SECONDS=8
MEMORY_EXTRACTION=auto


# Per-account fixed UTC minute/day windows; durable conservative input+output units.
ACCOUNT_REQUESTS_PER_MINUTE=6
ACCOUNT_DAILY_TOKEN_BUDGET=60000

# --- Operations ---
# Account ids allowed to see /api/admin/dashboard. EMPTY MEANS NOBODY.
ADMIN_ACCOUNTS=[]
# Alerting. Set at least one channel or nothing will ever reach you.
# Any webhook that accepts JSON works: Discord, Slack, ntfy.
ALERT_WEBHOOK_URL=
# Or Telegram: @BotFather for the token, @userinfobot for the chat id.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Alert once this many unhandled errors have happened since start.
ALERT_ERROR_THRESHOLD=3
