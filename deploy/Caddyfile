{$DOMAIN} {
  encode gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=31536000"
    # Everything is same-origin: scripts, styles, self-hosted fonts, images,
    # and /api (chat streams included). data: images are the CSS textures.
    # 'unsafe-inline' scripts: Next.js inlines its page data as <script> tags,
    # and a nonce would need per-request rendering. Styles: server-rendered
    # style="" attributes. See docs/DEPLOYMENT.md, "Content Security Policy".
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  }
  handle /api/* {
    reverse_proxy backend:8000 {
      flush_interval -1
    }
  }
  handle {
    reverse_proxy frontend:3000
  }
}

