{$DOMAIN} {
  encode gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=31536000"
  }
  handle /api/* {
    reverse_proxy backend:8000 {
      flush_interval -1
    }
  }
  handle {
    reverse_proxy frontend:3000
  }
}

