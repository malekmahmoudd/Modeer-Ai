# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database ---
# SQLite (zero setup, default if unset):
#   DATABASE_URL=sqlite+pysqlite:///./modeer.db
# PostgreSQL (recommended; matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg://modeer:modeer@localhost:5432/modeer

# --- App ---
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000

# --- LLM provider ---
# Supported: "mock" (no key, context-aware placeholders),
#            "anthropic" (Claude Messages API),
#            "groq" / "openai" (OpenAI-compatible chat completions).
# For groq/openai, LLM_BASE_URL is optional (groq default is
# https://api.groq.com/openai/v1). Streaming is used for all providers.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_BASE_URL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.6

# --- Memory extraction ---
MEMORY_STORE_SENSITIVE=false
MEMORY_MIN_CONFIDENCE=0.55

# Per-account fixed UTC minute/day windows; durable conservative input+output units.
ACCOUNT_REQUESTS_PER_MINUTE=6
ACCOUNT_DAILY_TOKEN_BUDGET=60000
