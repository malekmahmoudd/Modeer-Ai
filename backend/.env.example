# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database ---
# SQLite (zero setup, default if unset):
#   DATABASE_URL=sqlite+pysqlite:///./modeer.db
# PostgreSQL (recommended; matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg://modeer:modeer@localhost:5432/modeer

# --- App ---
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000

# --- LLM provider ---
# "mock" needs no key and returns context-aware placeholder responses.
# "anthropic" uses the Claude Messages API (streaming).
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_BASE_URL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.6

# --- Memory extraction ---
MEMORY_STORE_SENSITIVE=false
MEMORY_MIN_CONFIDENCE=0.55
